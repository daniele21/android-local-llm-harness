<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="io.github.daniele21.localllm.debug.permission.CONTROL_LOCAL_LLM_E2E"
        android:protectionLevel="signature" />

    <application>
        <receiver
            android:name=".EmulatorE2eFaultReceiver"
            android:exported="true"
            android:permission="io.github.daniele21.localllm.debug.permission.CONTROL_LOCAL_LLM_E2E">
            <intent-filter>
                <action android:name="io.github.daniele21.localllm.phonetest.emulatorE2e.PAUSE_GENERATION" />
                <action android:name="io.github.daniele21.localllm.phonetest.emulatorE2e.RELEASE_GENERATION" />
                <action android:name="io.github.daniele21.localllm.phonetest.emulatorE2e.RESET" />
                <action android:name="io.github.daniele21.localllm.phonetest.emulatorE2e.QUERY" />
                <action android:name="io.github.daniele21.localllm.phonetest.emulatorE2e.QUERY_ACTIVITY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>